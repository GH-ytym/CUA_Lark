# Backend
APP_ENV=development
APP_NAME=CUA-Lark
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://127.0.0.1:5173
REDIS_URL=redis://127.0.0.1:6379/0
EVENT_BACKEND=memory

# Feishu / AppLink
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_LINK_TOKEN=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# Lark-CLI
LARK_CLI_PATH=
LARK_CLI_TIMEOUT_SECONDS=20
LARK_CLI_WORKDIR=./runtime/lark-cli

# Intent / LLM
DASHSCOPE_API_KEY=
QWEN_CHAT_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL=qwen3.6-max
QWEN_TIMEOUT_SECONDS=20
QWEN_INTENT_TIMEOUT_SECONDS=20
QWEN_RECIPIENT_TIMEOUT_SECONDS=6
INTENT_REQUIRE_LLM=false
INTENT_MESSAGE_FASTPATH_ENABLED=true
RECIPIENT_SQLITE_PATH=data/lark_recipients.db
RECIPIENT_RESOLVER_TOP_K=12
RECIPIENT_RESOLVER_USE_LLM=false

# CUA / Vision Model
CUA_MODEL_PROVIDER=
CUA_MODEL_NAME=
CUA_MODEL_API_BASE=
CUA_MODEL_API_KEY=
CUA_SCREENSHOT_DIR=./runtime/screenshots
CUA_MAX_STEPS=20
CUA_ACTION_DELAY_MS=400

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_APP_NAME=CUA-Lark
VITE_FEISHU_APP_ENTRY_URL=http://127.0.0.1:5173
